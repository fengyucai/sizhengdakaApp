# Copy this file to .env.cloud.local and fill in real cloud values.
# Do not commit .env.cloud.local.

# SQL Server connection used by migration scripts.
CLOUD_DB_SERVER=your-cloud-sqlserver-host,1433
CLOUD_DB_DATABASE=ai_sizheng
CLOUD_DB_USERNAME=your_db_user
CLOUD_DB_PASSWORD=your_db_password

# JDBC connection used by Spring Boot.
DB_URL=jdbc:sqlserver://your-cloud-sqlserver-host:1433;databaseName=ai_sizheng;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Security.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Face provider.
FACE_PROVIDER=TENCENT
TENCENT_CLOUD_SECRET_ID=YOUR_SECRET_ID
TENCENT_CLOUD_SECRET_KEY=YOUR_SECRET_KEY
TENCENT_CLOUD_APP_ID=YOUR_APP_ID
TENCENT_CLOUD_REGION=ap-guangzhou
TENCENT_FACE_GROUP=dorm_checkin

# Map / geocoding.
BAIDU_MAP_AK=YOUR_BAIDU_MAP_AK
BAIDU_AI_APP_ID=
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=

# Object storage. Keep MinIO for minimum-change deployment, or replace with a cloud-compatible endpoint.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=YOUR_MINIO_SECRET
MINIO_BUCKET=ai-sizheng
