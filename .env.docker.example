# Copy this file to .env.docker.local and fill real secrets before deployment.

# Public browser/API endpoints
PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_PORT=8080
ADMIN_WEB_PORT=5173
DASHBOARD_PORT=5174

# Use an existing SQL Server by default.
# For Docker SQL Server profile, set:
# DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=ai_sizheng;encrypt=true;trustServerCertificate=true
DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=ai_sizheng;encrypt=true;trustServerCertificate=true
DB_USERNAME=aisizheng
DB_PASSWORD=

# Optional local SQL Server container. Must be strong enough for SQL Server policy.
MSSQL_SA_PASSWORD=AiSizheng@2026
SQLSERVER_PORT=1433

# Redis / MinIO
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
MINIO_BUCKET=ai-sizheng

# Security
JWT_SECRET=replace-with-at-least-32-random-characters

# AI / map providers
FACE_PROVIDER=BAIDU
BAIDU_AI_APP_ID=
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=
BAIDU_MAP_AK=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_APP_ID=
TENCENT_CLOUD_REGION=ap-guangzhou
TENCENT_FACE_GROUP=dorm_checkin
